# CuraMoney Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=postgresql://ai_user:curamoney_dev@localhost:5432/curamoney

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=8000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Base URL (for generating links in emails/notifications)
APP_BASE_URL=http://localhost:5173
