// CuraMoney — Chura Mill Management System
// PostgreSQL schema designed with Prisma ORM
// All monetary and weight values use Decimal (PostgreSQL numeric) — never floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Role-based access control
// ---------------------------------------------------------------------------

model Role {
  id            Int       @id @default(autoincrement())
  name          String    @unique // OWNER, MANAGER, OPERATOR, ACCOUNTANT
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g. "orders.create"
  description String?
  resource    String   // e.g. "orders"
  action      String   // e.g. "create"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Users & authentication
// ---------------------------------------------------------------------------

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  name          String
  mobile        String?
  roleId        Int
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders            Order[]
  productionRecords ProductionRecord[]
  weighments        WeighmentRecord[]
  payments          Payment[]
  deliveries        Delivery[]
  expenses          Expense[]
  statusHistory     OrderStatusHistory[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  customerId    String   @unique // e.g. CM-CUST-20260001
  name          String
  mobile        String   @unique
  altMobile     String?
  village       String?
  district      String?
  address       String?
  notes         String?
  openingBalance Decimal @default(0) @db.Decimal(12, 2)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders            Order[]
  payments          Payment[]
  customerLedger    CustomerLedger[]

  @@index([mobile])
  @@index([isArchived])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                 String   @id @default(cuid())
  orderId            String   @unique // e.g. CM-2026-0001
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderDate          DateTime @default(now())
  expectedCompletion DateTime?

  // Raw material
  materialType       String
  quantity           Decimal  @db.Decimal(12, 3)
  weightUnit         String   // KG, QUINTAL, TONNE
  bags               Int      @default(1)

  // Pricing
  ratePerUnit        Decimal  @db.Decimal(12, 2)
  processingCharges  Decimal  @default(0) @db.Decimal(12, 2)
  additionalCharges  Decimal  @default(0) @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)

  // Computed totals
  subtotal           Decimal  @db.Decimal(12, 2)
  finalAmount        Decimal  @db.Decimal(12, 2)
  amountPaid         Decimal  @default(0) @db.Decimal(12, 2)
  remainingBalance   Decimal  @db.Decimal(12, 2)

  specialInstructions String?
  status             String   @default("ORDER_RECEIVED") // see processing stages
  createdById        Int
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              OrderItem[]
  production         ProductionRecord[]
  weighments         WeighmentRecord[]
  payments           Payment[]
  deliveries         Delivery[]
  statusHistory      OrderStatusHistory[]
  customerLedger     CustomerLedger[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialType String
  quantity    Decimal  @db.Decimal(12, 3)
  weightUnit  String
  ratePerUnit Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Processing stages (configurable)
// ---------------------------------------------------------------------------

model ProcessingStage {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // e.g. "weighment_completed"
  sequence    Int      @default(0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderStatusHistory OrderStatusHistory[]

  @@index([slug])
  @@index([sequence])
  @@map("processing_stages")
}

// ---------------------------------------------------------------------------
// Order status history (audit)
// ---------------------------------------------------------------------------

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus   String
  updatedById   Int
  updatedBy     User     @relation(fields: [updatedById], references: [id])
  stageId       String?
  stage         ProcessingStage? @relation(fields: [stageId], references: [id])
  remarks       String?
  changedAt   DateTime @default(now())

  @@index([orderId])
  @@index([changedAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Weighment records (input/output weights, auditable, never overwritten)
// ---------------------------------------------------------------------------

model WeighmentRecord {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchNumber        Int      @default(1)
  inputWeight        Decimal  @db.Decimal(12, 3)   // raw material input weight
  weightUnit         String
  bags               Int      @default(1)
  weightBeforeProcessing Decimal? @db.Decimal(12, 3)
  finishedWeight     Decimal? @db.Decimal(12, 3)   // finished chura weight
  brokenQty          Decimal  @default(0) @db.Decimal(12, 3)
  byProductQty       Decimal  @default(0) @db.Decimal(12, 3)
  wastageQty         Decimal  @default(0) @db.Decimal(12, 3)
  finalVerifiedQty   Decimal? @db.Decimal(12, 3)
  yieldPercent       Decimal? @db.Decimal(6, 2)
  qualityRemarks     String?
  productionNotes    String?
  recordedById       Int
  recordedBy         User     @relation(fields: [recordedById], references: [id])
  recordedAt         DateTime @default(now())

  @@index([orderId])
  @@index([recordedAt])
  @@map("weighment_records")
}

// ---------------------------------------------------------------------------
// Production records (processing timing, operator, machine)
// ---------------------------------------------------------------------------

model ProductionRecord {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processingStart    DateTime?
  processingEnd      DateTime?
  operatorName       String?
  machineInfo        String?
  qualityRemarks     String?
  productionNotes    String?
  createdById        Int
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orderId])
  @@map("production_records")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id            String   @id @default(cuid())
  paymentId     String   @unique // e.g. CM-PAY-20260001
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   // CASH, UPI, BANK_TRANSFER, OTHER
  transactionRef String?
  paymentDate   DateTime @default(now())
  remarks       String?
  isReversed    Boolean  @default(false)
  reversalId    String?  // links to reversal payment
  recordedById  Int
  recordedBy    User     @relation(fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())

  customerLedger CustomerLedger[]

  @@index([customerId])
  @@index([orderId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Customer ledger (double-entry style, auditable)
// ---------------------------------------------------------------------------

model CustomerLedger {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type        String   // DEBIT (charge) / CREDIT (payment)
  amount      Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal @db.Decimal(12, 2)
  reference   String?  // e.g. orderId, paymentId, "OPENING"
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_ledger")
}

// ---------------------------------------------------------------------------
// Deliveries
// ---------------------------------------------------------------------------

model Delivery {
  id            String   @id @default(cuid())
  deliveryId    String   @unique // e.g. CM-DEL-20260001
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  readyQuantity Decimal  @db.Decimal(12, 3)
  deliveredQuantity Decimal @db.Decimal(12, 3)
  remainingQuantity Decimal @db.Decimal(12, 3)
  deliveryDate  DateTime @default(now())
  receiverName  String?
  receiverPhone String?
  remarks       String?
  confirmed     Boolean  @default(false)
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([deliveryDate])
  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id      String   @id @default(cuid())
  name    String   @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id           String   @id @default(cuid())
  expenseId    String   @unique // e.g. CM-EXP-20260001
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  description  String
  amount       Decimal  @db.Decimal(12, 2)
  paymentMethod String
  expenseDate  DateTime
  recordedById Int
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  receiptUrl   String?
  createdAt    DateTime @default(now())

  @@index([categoryId])
  @@index([expenseDate])
  @@index([recordedById])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ORDER_CREATED, PROCESSING_STARTED, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  relatedId String?  // order id, payment id, etc.
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Business settings (key-value, configurable)
// ---------------------------------------------------------------------------

model BusinessSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   // BUSINESS, OPERATIONAL, SYSTEM
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("business_settings")
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // e.g. "Order", "Payment"
  entityId  String?
  oldValues String?  // JSON
  newValues String?  // JSON
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// OTP tokens (email/mobile verification, signup, password reset)
// ---------------------------------------------------------------------------
model OtpToken {
  id        String   @id @default(cuid())
  email     String?
  mobile    String?
  otp       String   // 6-digit code
  purpose   String   // SIGNUP, LOGIN, FORGOT_PASSWORD
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([mobile])
  @@index([purpose])
  @@index([expiresAt])
  @@map("otp_tokens")
}
